# Copy this file to .env.local for local development, and mirror the same
# keys into your Vercel Project Settings -> Environment Variables for deploys.

# --- Database (MongoDB Atlas) ---
# Connection string for your Atlas cluster. Include the database name at the end.
MONGODB_URI=mongodb+srv://your_db_user:your_db_password@your-cluster.mongodb.net/?appName=your-app-name

# --- Paystack (use TEST keys until you are ready to go live) ---
# https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public base URL of the deployed site (no trailing slash). Used to build the
# Paystack callback_url. Set this to your Vercel URL / custom domain in prod.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Admin dashboard (/admin) ---
# Plain password used to sign in to /admin. Choose something strong.
ADMIN_PASSWORD=change-me-please
# Secret used to sign the admin session cookie (any long random string).
ADMIN_SESSION_SECRET=change-me-too-a-long-random-string

# --- Optional: only needed if you seed initial voting window dates via the
# seed script (scripts/seed.ts). Once seeded, edit dates from /admin instead.
VOTING_STARTS_AT=2026-08-01T17:00:00.000Z
VOTING_ENDS_AT=2026-08-15T23:59:59.000Z
